@model ProductsListViewModel
@using SportsStore.WebUI.Infrastructure

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <h2>Danh sách sản phẩm (MOCK DATA)</h2>
    @if (Model.Products == null || !Model.Products.Any())
    {
        <p><em>Không có sản phẩm nào.</em></p>
    }
    else
    {
        <div class="row">
            @foreach (var p in Model.Products)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="card-title">@p.Name</h5>
                                <p class="card-text text-muted">@p.Description</p>
                                <span class="badge bg-secondary mb-2">@p.Category</span>
                            </div>
                            <div>
                                <h4 class="text-danger">@p.Price.ToString("C")</h4>
                                <form asp-action="AddToCart" asp-controller="Cart" method="post" class="mt-2">
                                    <input type="hidden" name="productId" value="@p.ProductID" />
                                    <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.PathAndQuery()" />
                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                        Thêm vào giỏ hàng
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div page-model="@Model.PagingInfo"
             page-action="Index"
             page-classes-enabled="true"
             page-class="btn"
             page-class-normal="btn-outline-secondary"
             page-class-selected="btn-primary"
             page-url-category="@Model.CurrentCategory!"
             class="btn-group pull-right m-1">
        </div>
    }
</div>
