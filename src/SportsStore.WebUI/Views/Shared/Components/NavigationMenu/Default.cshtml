@model IEnumerable<string>

<div class="d-grid gap-2">
    <a class="btn @(ViewBag.SelectedCategory == null ? "btn-primary" : "btn-outline-secondary")"
       asp-controller="Home"
       asp-action="Index"
       asp-route-category="">
        Trang chủ
    </a>

    @foreach (string category in Model)
    {
        <a class="btn @(category == ViewBag.SelectedCategory ? "btn-primary" : "btn-outline-secondary")"
           asp-controller="Home"
           asp-action="Index"
           asp-route-category="@category">
            @category
        </a>
    }
</div>
